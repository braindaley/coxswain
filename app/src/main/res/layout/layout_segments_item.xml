<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        >

        <!-- Drag handle / Duplicate button -->
        <ImageButton
            android:id="@+id/segment_menu"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_drag_handle_24dp"
            android:contentDescription="@string/action_duplicate"
            android:background="?android:attr/selectableItemBackgroundBorderless"
        />

        <!-- Target Metric -->
        <include
            android:id="@+id/segments_item_target"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            layout="@layout/layout_binding"
        />

        <!-- Limit / Goal Metric -->
        <include
            android:id="@+id/segments_item_limit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            layout="@layout/layout_binding"
        />

        <!-- Intensity / Difficulty Indicator -->
        <svenmeier.coxswain.view.LevelView
            android:id="@+id/segments_difficulty"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/segment"
            style="@style/MenuButton"
        />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
