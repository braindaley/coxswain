<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/segments_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    android:background="?android:attr/colorBackground"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        >

        <!-- Left Accent Intensity Strip -->
        <View
            android:id="@+id/segment_intensity_strip"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/primary"
        />

        <!-- Drag Handle (touch & drag to reorder) -->
        <ImageButton
            android:id="@+id/segment_menu"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_reorder_24dp"
            android:contentDescription="@string/action_duplicate"
            android:background="?android:attr/selectableItemBackgroundBorderless"
        />

        <!-- Main Content Area: Target Hero Metric & Subtitle -->
        <LinearLayout
            android:id="@+id/segment_target_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            >

            <TextView
                android:id="@+id/segment_target_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:text="1,000 m"
            />

            <TextView
                android:id="@+id/segment_target_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="Distance"
            />
        </LinearLayout>

        <!-- Goal / Limit Chip (e.g. [+ Set goal] or [⚡ 26 spm]) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/segment_goal_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="+ Set goal"
            android:textSize="12sp"
            app:chipCornerRadius="8dp"
            style="@style/Widget.Material3.Chip.Assist"
        />

        <!-- Intensity Badge Button (Tappable to cycle difficulty) -->
        <TextView
            android:id="@+id/segments_difficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/badge_duration"
            android:text="EASY"
            android:clickable="true"
            android:focusable="true"
        />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/segment_delete"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_delete_24dp"
            android:contentDescription="@string/action_delete"
            android:background="?android:attr/selectableItemBackgroundBorderless"
        />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
