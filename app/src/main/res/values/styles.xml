<resources>
    <style name="LightTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorAccent">@color/accent</item>

        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <item name="icon_more">@drawable/ic_more_vert_black_24dp</item>
        <item name="icon_share">@drawable/ic_share_black_24dp</item>
        <item name="icon_duplicate">@drawable/baseline_filter_none_black_24</item>
    </style>

    <style name="DarkTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#8DB8FF</item>
        <item name="colorOnPrimary">#0A1C35</item>
        <item name="colorPrimaryDark">#0F141A</item>
        <item name="colorPrimaryContainer">#203753</item>
        <item name="colorOnPrimaryContainer">#E0EBFF</item>
        <item name="colorSecondary">#A9C7EE</item>
        <item name="colorOnSecondary">#10243D</item>
        <item name="colorSecondaryContainer">#253448</item>
        <item name="colorOnSecondaryContainer">#DCE7F5</item>
        <item name="colorAccent">#8DB8FF</item>
        <item name="colorControlActivated">#8DB8FF</item>
        <item name="android:colorBackground">#0F141A</item>
        <item name="android:windowBackground">#0F141A</item>
        <item name="android:colorForeground">#E5EBF2</item>
        <item name="android:textColorPrimary">#E5EBF2</item>
        <item name="android:textColorSecondary">#AEBBCB</item>
        <item name="android:statusBarColor">#0F141A</item>
        <item name="android:navigationBarColor">#19212A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorSurface">#19212A</item>
        <item name="colorOnSurface">#E5EBF2</item>
        <item name="colorSurfaceVariant">#26323F</item>
        <item name="colorOnSurfaceVariant">#AEBBCB</item>
        <item name="colorOutline">#798A9F</item>

        <item name="actionBarTheme">@style/CoxswainDarkAppBar</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <item name="icon_more">@drawable/ic_more_vert_white_24dp</item>
        <item name="icon_share">@drawable/ic_share_white_24dp</item>
        <item name="icon_duplicate">@drawable/baseline_filter_none_white_24</item>
    </style>

    <style name="DialogTheme" parent="Theme.Material3.Light.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowMinWidthMinor">75%</item>
        <item name="android:windowMinWidthMajor">75%</item>
        <item name="windowFixedHeightMajor">75%</item>
        <item name="windowFixedHeightMinor">75%</item>
    </style>

    <style name="CoxswainDarkAppBar" parent="ThemeOverlay.Material3.Dark">
        <item name="colorSurface">#19212A</item>
        <item name="colorOnSurface">#E5EBF2</item>
        <item name="colorPrimary">#8DB8FF</item>
    </style>

    <style name="AppBar">
        <item name="android:theme">?attr/actionBarTheme</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabGravity">fill</item>
        <item name="tabIndicatorColor">@color/accent</item>
    </style>

    <style name="TimelineView">
        <item name="foreground_color">?android:attr/colorForeground</item>
    </style>

    <style name="TimelineTitle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">3dp</item>
    </style>

    <style name="BindingView">
        <item name="android:background">@drawable/binding</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="layout_columnWeight">1</item>
        <item name="layout_rowWeight">1</item>
    </style>

    <style name="LabelView">
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">1dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:layout_margin">0dp</item>
    </style>

    <style name="MenuButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
    </style>

    <style name="TableCell">
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:editable">false</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
